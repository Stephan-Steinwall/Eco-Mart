<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Display: Fraunces, for moments — splash, big screen titles -->
    <style name="TextAppearance.EcoMart.Display" parent="">
        <item name="android:fontFamily">@font/fraunces_var</item>
        <item name="fontFamily">@font/fraunces_var</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingMultiplier">1.02</item>
    </style>

    <style name="TextAppearance.EcoMart.Headline" parent="">
        <item name="android:fontFamily">@font/fraunces_var</item>
        <item name="fontFamily">@font/fraunces_var</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.EcoMart.Title" parent="">
        <item name="android:fontFamily">@font/jakarta_var</item>
        <item name="fontFamily">@font/jakarta_var</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textFontWeight" tools:targetApi="28">700</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.EcoMart.Body" parent="">
        <item name="android:fontFamily">@font/jakarta_var</item>
        <item name="fontFamily">@font/jakarta_var</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="TextAppearance.EcoMart.BodyMedium" parent="">
        <item name="android:fontFamily">@font/jakarta_var</item>
        <item name="fontFamily">@font/jakarta_var</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textFontWeight" tools:targetApi="28">600</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.EcoMart.Label" parent="">
        <item name="android:fontFamily">@font/jakarta_var</item>
        <item name="fontFamily">@font/jakarta_var</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textFontWeight" tools:targetApi="28">500</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.EcoMart.Caption" parent="">
        <item name="android:fontFamily">@font/jakarta_var</item>
        <item name="fontFamily">@font/jakarta_var</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="TextAppearance.EcoMart.Price" parent="">
        <item name="android:fontFamily">@font/fraunces_var</item>
        <item name="fontFamily">@font/fraunces_var</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_primary</item>
    </style>

    <style name="TextAppearance.EcoMart.PriceLarge" parent="">
        <item name="android:fontFamily">@font/fraunces_var</item>
        <item name="fontFamily">@font/fraunces_var</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_primary</item>
    </style>

    <!-- Reusable surfaces -->
    <style name="EcoMart.Card" parent="">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="EcoMart.Chip" parent="">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">7dp</item>
    </style>
</resources>
