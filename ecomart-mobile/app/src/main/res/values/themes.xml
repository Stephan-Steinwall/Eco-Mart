<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.EcoMart" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary_dark</item>

        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/brand_accent_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_accent_dark</item>

        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline_strong</item>
        <item name="colorOutlineVariant">@color/outline</item>

        <item name="colorError">@color/error</item>
        <item name="colorErrorContainer">@color/error_container</item>

        <item name="android:fontFamily">@font/jakarta_var</item>
        <item name="fontFamily">@font/jakarta_var</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.EcoMart.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.EcoMart.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.EcoMart.Large</item>

        <item name="materialButtonStyle">@style/Widget.EcoMart.Button</item>
        <item name="textInputStyle">@style/Widget.EcoMart.TextInputLayout</item>
        <item name="bottomNavigationStyle">@style/Widget.EcoMart.BottomNav</item>
    </style>

    <style name="Theme.EcoMart" parent="Base.Theme.EcoMart" />

    <!-- Shape -->
    <style name="ShapeAppearance.EcoMart.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>
    <style name="ShapeAppearance.EcoMart.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeAppearance.EcoMart.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Widgets -->
    <style name="Widget.EcoMart.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/jakarta_var</item>
        <item name="android:fontFamily">@font/jakarta_var</item>
        <item name="android:textFontWeight" tools:targetApi="28">600</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="rippleColor">@color/brand_primary_container</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.EcoMart.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/jakarta_var</item>
        <item name="android:fontFamily">@font/jakarta_var</item>
        <item name="android:textFontWeight" tools:targetApi="28">600</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="strokeColor">@color/outline_strong</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="rippleColor">@color/surface_alt</item>
    </style>

    <style name="Widget.EcoMart.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="fontFamily">@font/jakarta_var</item>
        <item name="android:fontFamily">@font/jakarta_var</item>
        <item name="android:textFontWeight" tools:targetApi="28">600</item>
        <item name="backgroundTint">@color/brand_primary_container</item>
        <item name="android:textColor">@color/brand_primary_dark</item>
        <item name="rippleColor">@color/brand_primary</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.EcoMart.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/brand_primary</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/brand_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxBackgroundColor">@color/surface</item>
    </style>

    <style name="Widget.EcoMart.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/bottom_nav_colors</item>
        <item name="itemTextColor">@color/bottom_nav_colors</item>
        <item name="itemRippleColor">@color/brand_primary_container</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
</resources>
