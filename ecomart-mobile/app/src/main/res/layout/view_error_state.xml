<?xml version="1.0" encoding="utf-8"?>
<!-- Full-area "connection lost / try again" page. Drop it over a screen's content with
     <include android:id="@+id/errorState" layout="@layout/view_error_state"/> and drive it with ErrorStateController. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/errorStateRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="32dp"
    android:visibility="gone">

    <FrameLayout
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/bg_icon_circle">

        <ImageView
            android:id="@+id/ivErrorIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_cloud_off"
            app:tint="@color/text_secondary" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvErrorTitle"
        style="@style/TextAppearance.EcoMart.Headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="You're offline"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tvErrorMessage"
        style="@style/TextAppearance.EcoMart.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Check your connection and try again."
        android:textColor="@color/text_secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnErrorAction"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginTop="28dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="180dp"
        android:text="Try again" />
</LinearLayout>
