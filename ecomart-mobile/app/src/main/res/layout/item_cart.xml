<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivCartImage"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:background="@color/surface_alt" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp">

            <TextView
                android:id="@+id/tvCartName"
                style="@style/TextAppearance.EcoMart.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product Name"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvCartPrice"
                style="@style/TextAppearance.EcoMart.Price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:text="Rs. 0.00"/>

            <TextView
                android:id="@+id/tvRemove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Remove"
                android:textSize="12sp"
                android:fontFamily="@font/jakarta_var"
                android:textFontWeight="600"
                android:drawableStart="@drawable/ic_trash"
                android:drawableTint="@color/error"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp"
                android:textColor="@color/error"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_qty_stepper"
            android:paddingHorizontal="4dp">

            <TextView
                android:id="@+id/btnCartMinus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:text="−"
                android:gravity="center"
                android:textSize="18sp"
                android:fontFamily="@font/jakarta_var"
                android:textFontWeight="700"
                android:background="@drawable/ripple_pill"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/tvCartQuantity"
                android:layout_width="26dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:gravity="center"
                android:textSize="15sp"
                android:fontFamily="@font/jakarta_var"
                android:textFontWeight="700"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/btnCartPlus"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:text="+"
                android:gravity="center"
                android:textSize="18sp"
                android:fontFamily="@font/jakarta_var"
                android:textFontWeight="700"
                android:background="@drawable/ripple_pill"
                android:textColor="@color/brand_primary"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
