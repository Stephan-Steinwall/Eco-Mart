<?xml version="1.0" encoding="utf-8"?>
<!-- Timed-offer banner shown on Home while an offer is active. Hidden until an offer is loaded. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/offerBanner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginBottom="14dp"
    android:visibility="gone"
    app:cardBackgroundColor="@color/brand_accent_container"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOfferTitle"
                style="@style/TextAppearance.EcoMart.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Weekend Fresh Sale"
                android:textColor="@color/brand_accent_dark" />

            <TextView
                android:id="@+id/tvOfferMessage"
                style="@style/TextAppearance.EcoMart.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Fresh produce, fresh prices."
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvOfferCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/jakarta_var"
                android:text="Ends in 02:14:09"
                android:textColor="@color/brand_accent_dark"
                android:textFontWeight="700"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOfferDiscount"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_discount_badge"
            android:fontFamily="@font/fraunces_var"
            android:gravity="center"
            android:text="20%\nOFF"
            android:textColor="@color/on_accent"
            android:textFontWeight="800"
            android:textSize="15sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
