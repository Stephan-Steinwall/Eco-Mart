<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:foreground="@drawable/ripple_rounded_20"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvOrderId"
                style="@style/TextAppearance.EcoMart.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:text="Order #1234"/>

            <TextView
                android:id="@+id/tvOrderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING"
                android:textSize="11sp"
                android:fontFamily="@font/jakarta_var"
                android:textFontWeight="700"
                android:letterSpacing="0.03"
                android:textColor="@color/brand_accent_dark"
                android:background="@drawable/bg_chip"
                android:backgroundTint="@color/brand_accent_container"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvOrderDate"
            style="@style/TextAppearance.EcoMart.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date: 2024-05-20"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvOrderTotal"
            style="@style/TextAppearance.EcoMart.Price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:text="Total: Rs. 0.00"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
